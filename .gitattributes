# Default behaviour: normalise to LF on commit
* text=auto eol=lf

# Source files
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary

# Files excluded from release archives generated by GitHub
.gitignore export-ignore
.gitattributes export-ignore
.github export-ignore
tests export-ignore
CONTRIBUTING.md export-ignore
